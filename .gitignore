# ==============================================================================
# MineMarket Git Ignore Rules
# ==============================================================================

# 1. Environments, Credentials and Secrets (CRITICAL: NEVER COMMIT REAL SECRETS)
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
*.env
backend/.env
frontend/.env

# Whitelist environment templates
!.env.example
!.env.clone
!.env.template
!backend/.env.example
!backend/.env.clone
!backend/.env.template
!frontend/.env.example
!frontend/.env.clone
!frontend/.env.template

# 2. Node Dependencies and Package Manager Logs
node_modules/
backend/node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 3. Production Builds, Test Reports and Coverage
dist/
dist-ssr/
build/
out/
.cache/
coverage/
backend/coverage/
frontend/coverage/
frontend/dist/
frontend/build/
frontend/playwright-report/
frontend/test-results/
.scannerwork/

# 4. Logs, Temp and Runtime Artifacts
logs/
*.log
*.jtl
jmeter-report/
*.sqlite
*.sqlite3
backend/data/store.json

# 5. Operating System and IDE Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
