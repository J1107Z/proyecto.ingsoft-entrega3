# ==============================================================================
# MineMarket Backend Environment Variables (TEMPLATE)
# Copia este archivo a ".env" y reemplaza los valores según tu entorno.
# ¡NUNCA SUBAS TU ARCHIVO .env REAL AL REPOSITORIO GIT!
# ==============================================================================

PORT=4000
NODE_ENV=development

# Base de Datos (PostgreSQL / Supabase / Neon / Render Postgres)
# Deja en blanco para usar persistencia local en JSON (src/data/store.json)
DATABASE_URL=

# Seguridad y Tokens JWT (RNF01: HS256, TTL máximo 2h)
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_aqui_64_caracteres
JWT_EXPIRES_IN=2h

# Origen permitido para CORS
FRONTEND_ORIGIN=http://localhost:5173
